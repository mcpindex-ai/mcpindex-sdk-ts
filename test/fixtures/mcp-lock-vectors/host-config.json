[
  {
    "name": "outside-repository",
    "note": "Both paths outside the git repository that holds the lock.",
    "dirs": [
      "repo/.git",
      "repo/.mcp/lock",
      "state"
    ],
    "lockRoot": "repo",
    "sequencePath": "state/sequence",
    "trustedRoot": "state/trusted_root.json",
    "expect": "accept"
  },
  {
    "name": "not-yet-created",
    "note": "A sequence file that does not exist yet, in a directory that does not either.",
    "dirs": [
      "repo/.git",
      "repo/.mcp/lock"
    ],
    "lockRoot": "repo",
    "sequencePath": "state/new/sequence",
    "expect": "accept"
  },
  {
    "name": "sequence-in-lock-root",
    "note": "No repository: the lock root is the boundary.",
    "dirs": [
      "lockroot/.mcp/lock"
    ],
    "lockRoot": "lockroot",
    "sequencePath": "lockroot/state/sequence",
    "expect": "refuse"
  },
  {
    "name": "no-repository-sibling",
    "note": "No repository: a sibling of the lock root is outside it.",
    "dirs": [
      "work/lock/.mcp/lock",
      "work/state"
    ],
    "lockRoot": "work/lock",
    "sequencePath": "work/state/sequence",
    "expect": "accept"
  },
  {
    "name": "sequence-in-repository",
    "note": "Lock root below the git top-level; the sequence file elsewhere in the repository.",
    "dirs": [
      "repo/.git",
      "repo/sub/.mcp/lock",
      "repo/state"
    ],
    "lockRoot": "repo/sub",
    "sequencePath": "repo/state/sequence",
    "expect": "refuse"
  },
  {
    "name": "trusted-root-in-repository",
    "note": "The trust root inside the repository, outside the lock root.",
    "dirs": [
      "repo/.git",
      "repo/sub/.mcp/lock",
      "state"
    ],
    "lockRoot": "repo/sub",
    "sequencePath": "state/sequence",
    "trustedRoot": "repo/trusted_root.json",
    "expect": "refuse"
  },
  {
    "name": "git-file",
    "note": "A .git file, as in a git worktree, marks the repository too.",
    "dirs": [
      "repo/sub/.mcp/lock",
      "repo/state"
    ],
    "files": [
      "repo/.git"
    ],
    "lockRoot": "repo/sub",
    "sequencePath": "repo/state/sequence",
    "expect": "refuse"
  },
  {
    "name": "symlink-into-repository",
    "note": "A path outside the repository that resolves into it.",
    "dirs": [
      "repo/.git",
      "repo/.mcp/lock",
      "repo/state"
    ],
    "lockRoot": "repo",
    "symlinks": [
      {
        "path": "link",
        "target": "repo/state"
      }
    ],
    "sequencePath": "link/sequence",
    "expect": "refuse"
  },
  {
    "name": "symlink-out-of-repository",
    "note": "A path inside the repository that resolves outside it.",
    "dirs": [
      "repo/.git",
      "repo/.mcp/lock",
      "state"
    ],
    "lockRoot": "repo",
    "symlinks": [
      {
        "path": "repo/out",
        "target": "../state"
      }
    ],
    "trustedRoot": "repo/out/trusted_root.json",
    "expect": "refuse"
  },
  {
    "name": "symlink-then-dotdot",
    "note": "A .. after a symbolic link goes up from the link's target, not from the link.",
    "dirs": [
      "repo/.git",
      "repo/.mcp/lock",
      "outside"
    ],
    "lockRoot": "repo",
    "symlinks": [
      {
        "path": "outside/lnk",
        "target": "../repo/.mcp"
      }
    ],
    "sequencePath": "outside/lnk/../sequence",
    "expect": "refuse"
  },
  {
    "name": "dotdot-below-existing",
    "note": "A .. in the part of the path that does not exist yet.",
    "dirs": [
      "repo/.git",
      "repo/.mcp/lock",
      "state"
    ],
    "lockRoot": "repo",
    "sequencePath": "state/new/../sequence",
    "expect": "refuse"
  },
  {
    "name": "submodule-superproject",
    "note": "A submodule's .git file points under modules/; the superproject holds the lock.",
    "dirs": [
      "super/.git/modules/sm",
      "super/sm/.mcp/lock",
      "super/other"
    ],
    "texts": [
      {
        "path": "super/sm/.git",
        "text": "gitdir: ../.git/modules/sm\n"
      }
    ],
    "lockRoot": "super/sm",
    "sequencePath": "super/other/sequence",
    "expect": "refuse"
  },
  {
    "name": "worktree-top",
    "note": "A linked worktree's .git file points under worktrees/; the worktree is the repository.",
    "dirs": [
      "main/.git/worktrees/wt",
      "outer/.git",
      "outer/wt/.mcp/lock",
      "outer/state"
    ],
    "texts": [
      {
        "path": "outer/wt/.git",
        "text": "gitdir: ../../main/.git/worktrees/wt\n"
      }
    ],
    "lockRoot": "outer/wt",
    "sequencePath": "outer/state/sequence",
    "expect": "accept"
  },
  {
    "name": "git-file-unreadable-continues",
    "note": "A .git file that names no worktree: the walk goes on to the enclosing repository.",
    "dirs": [
      "outer/.git",
      "outer/repo/sub/.mcp/lock",
      "outer/state"
    ],
    "files": [
      "outer/repo/.git"
    ],
    "lockRoot": "outer/repo/sub",
    "sequencePath": "outer/state/sequence",
    "expect": "refuse"
  }
]
