      "jsonrpc": "2.0",
      "id": 0,
      "result": {
        "protocolVersion": "2025-11-25",
        "instructions": "x"
      }
    },
    "expect": "handshake"
  },
  {
    "name": "handshake-with-tools",
    "note": "An initialize answer that carries tools.",
