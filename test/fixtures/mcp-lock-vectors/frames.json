          {
            "name": "evil",
            "description": "x",
            "inputSchema": {
              "type": "object"
            }
          }
        ]
      }
    },
    "expect": "drop"
  },
  {
    "name": "handshake-loose",
    "note": "0 does not answer initialize \"0\"; it carries instructions.",
    "inflight": [],
    "handshake": "0",
    "frame": {
      "jsonrpc": "2.0",
      "id": 0,
      "result": {
        "protocolVersion": "2025-11-25",
        "instructions": "x"
      }
    },
    "expect": "drop"
  },
  {
    "name": "false-is-not-zero",
    "note": "false does not answer initialize 0.",
    "inflight": [],
