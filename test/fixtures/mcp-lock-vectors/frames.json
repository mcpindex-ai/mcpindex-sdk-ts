[
  {
    "name": "listing-number-id",
    "note": "Answers an in-flight tools/list.",
    "inflight": [
      1
    ],
    "frame": {
      "jsonrpc": "2.0",
      "id": 1,
      "result": {
        "tools": [
          {
            "name": "evil",
            "description": "x",
            "inputSchema": {
              "type": "object"
            }
          }
        ]
      }
    },
    "expect": "listing"
  },
  {
    "name": "listing-string-id",
    "note": "String ids match equal strings.",
    "inflight": [
      "a"
    ],
    "frame": {
      "jsonrpc": "2.0",
      "id": "a",
      "result": {
        "tools": [
          {
            "name": "evil",
            "description": "x",
            "inputSchema": {
              "type": "object"
            }
          }
        ]
      }
    },
    "expect": "listing"
  },
  {
    "name": "listing-error",
    "note": "An error answer to an in-flight tools/list ends that listing.",
    "inflight": [
      1
    ],
    "frame": {
      "jsonrpc": "2.0",
      "id": 1,
      "error": {
        "code": -32603,
        "message": "x"
      }
    },
    "expect": "listing"
  },
  {
    "name": "string-is-not-number",
    "note": "\"1\" does not answer request 1.",
    "inflight": [
      1
    ],
    "frame": {
      "jsonrpc": "2.0",
      "id": "1",
      "result": {
        "tools": [
          {
            "name": "evil",
            "description": "x",
            "inputSchema": {
              "type": "object"
            }
          }
        ]
      }
    },
    "expect": "drop"
  },
  {
    "name": "number-is-not-string",
    "note": "1 does not answer request \"1\".",
    "inflight": [
      "1"
    ],
    "frame": {
      "jsonrpc": "2.0",
      "id": 1,
      "result": {
        "tools": [
          {
            "name": "evil",
            "description": "x",
            "inputSchema": {
              "type": "object"
            }
          }
        ]
      }
    },
    "expect": "drop"
  },
  {
    "name": "true-is-not-one",
    "note": "true does not answer request 1.",
    "inflight": [
      1
    ],
    "frame": {
      "jsonrpc": "2.0",
      "id": true,
      "result": {
        "tools": [
          {
            "name": "evil",
            "description": "x",
            "inputSchema": {
              "type": "object"
            }
          }
        ]
      }
    },
    "expect": "drop"
  },
  {
    "name": "null-id",
    "note": "A null id answers nothing, even if the host sent a request with a null id.",
    "inflight": [
      null
    ],
    "frame": {
      "jsonrpc": "2.0",
      "id": null,
      "result": {
        "tools": [
          {
            "name": "evil",
            "description": "x",
            "inputSchema": {
              "type": "object"
            }
          }
        ]
      }
    },
    "expect": "drop"
  },
  {
    "name": "no-id",
    "note": "A result without an id.",
    "inflight": [
      1
    ],
    "frame": {
      "jsonrpc": "2.0",
      "result": {
        "tools": [
          {
            "name": "evil",
            "description": "x",
            "inputSchema": {
              "type": "object"
            }
          }
        ]
      }
    },
    "expect": "drop"
  },
  {
    "name": "unmatched-id",
    "note": "No tools/list with this id is in flight.",
    "inflight": [
      1
    ],
    "frame": {
      "jsonrpc": "2.0",
      "id": 2,
      "result": {
        "tools": [
          {
            "name": "evil",
            "description": "x",
            "inputSchema": {
              "type": "object"
            }
          }
        ]
      }
    },
    "expect": "drop"
  },
  {
    "name": "method-and-result",
    "note": "A frame with both method and result is not a response.",
    "inflight": [
      1
    ],
    "frame": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "x",
      "result": {
        "tools": [
          {
            "name": "evil",
            "description": "x",
            "inputSchema": {
              "type": "object"
            }
          }
        ]
      }
    },
    "expect": "drop"
  },
  {
    "name": "method-null-and-result",
    "note": "A method member, even null, makes it not a response.",
    "inflight": [
      1
    ],
    "frame": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": null,
      "result": {
        "tools": [
          {
            "name": "evil",
            "description": "x",
            "inputSchema": {
              "type": "object"
            }
          }
        ]
      }
    },
    "expect": "drop"
  },
  {
    "name": "inflight-before-handshake",
    "note": "initialize \"1\" and tools/list 1 in flight; 1 is the listing.",
    "inflight": [
      1
    ],
    "handshake": "1",
    "frame": {
      "jsonrpc": "2.0",
      "id": 1,
      "result": {
        "tools": [
          {
            "name": "evil",
            "description": "x",
            "inputSchema": {
              "type": "object"
            }
          }
        ]
      }
    },
    "expect": "listing"
  },
  {
    "name": "same-id-both",
    "note": "One id on both: the in-flight tools/list wins.",
    "inflight": [
      7
    ],
    "handshake": 7,
    "frame": {
      "jsonrpc": "2.0",
      "id": 7,
      "result": {
        "tools": [
          {
            "name": "evil",
            "description": "x",
            "inputSchema": {
              "type": "object"
            }
          }
        ]
      }
    },
    "expect": "listing"
  },
  {
    "name": "handshake-exact",
    "note": "Answers the in-flight initialize.",
